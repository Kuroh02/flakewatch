# Flakewatch Environment Variables
# Copy this file to .env for local development or Docker Compose

# Active Spring profile: local, test, or prod
SPRING_PROFILES_ACTIVE=local

# PostgreSQL datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/flakewatch
SPRING_DATASOURCE_USERNAME=flakewatch
SPRING_DATASOURCE_PASSWORD=flakewatch

# Flakewatch application settings
FLAKEWATCH_PUBLIC_URL=http://localhost:8080
FLAKEWATCH_WORKERS=2
FLAKEWATCH_RETENTION_EXECUTIONS_DAYS=90
FLAKEWATCH_RETENTION_RAW_FILES_DAYS=7
FLAKEWATCH_METRICS_TOKEN=

# GitHub OAuth credentials (M2)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Container JVM memory tuning
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC -Xss512k -XX:ReservedCodeCacheSize=64m -XX:MaxMetaspaceSize=128m
